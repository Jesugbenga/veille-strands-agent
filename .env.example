# Supabase (read/write the same data Veille's app uses)
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VEILLE_BUSINESS_ID=your-business-uuid

# Amazon Bedrock model (Strands' default provider). MUST support function/tool
# calling. Available to you: mistral.ministral-3-14b-instruct (fast, cheap) or
# mistral.mistral-large-3-675b-instruct (most capable). Copy the exact "Model ID"
# from the model's page in the Bedrock console.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=mistral.ministral-3-14b-instruct
# AWS credentials come from `aws configure` or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
