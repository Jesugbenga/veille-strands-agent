# Supabase (read/write the same data Veille's app uses)
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VEILLE_BUSINESS_ID=your-business-uuid

# Amazon Bedrock model (Strands' default provider). MUST support tool calling.
# Amazon Nova Lite works well and is cheap. Use the cross-region inference
# profile ID (the 'us.' prefix). Alternative: us.amazon.nova-pro-v1:0.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS credentials come from `aws configure` or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
